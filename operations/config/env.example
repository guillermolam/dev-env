# Copy to a path outside Git (e.g. ~/.config/mac-environment/env).
# chmod 600 the file and the password file. Never commit secrets.

# export MAC_ENV_STATE_DIR=/private/var/lib/mac-environment
# export MAC_ENV_USE_INSTALLED_STATE=1
# export MAC_ENV_OPA=/path/to/opa-1.22.4
# export MAC_ENV_RESTIC=/path/to/restic
# export MAC_ENV_RESTIC_REPOSITORY=rclone:bucket:/mac-env
# export MAC_ENV_RESTIC_PASSWORD_FILE=/path/to/restic-password
# export MAC_ENV_FIREWALL_EVIDENCE=/path/to/firewall.json
# export MAC_ENV_TOOLING_EVIDENCE=/path/to/tooling.json
# export MAC_ENV_ACCESS_EVIDENCE=/path/to/access.json
# export MAC_ENV_INTEGRITY_EVIDENCE=/path/to/integrity.json
# export MAC_ENV_VULNIX_EVIDENCE=/path/to/vulnix.json
# export MAC_ENV_VULNIX_DB_OBSERVED_AT=2026-11-21T00:00:00Z
# export MAC_ENV_VULNIX_ROOT=$HOME/.nix-profile
