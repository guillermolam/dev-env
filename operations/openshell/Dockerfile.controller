# mac-env controller image for OpenShell (linux/arm64).
# Build (needs network for pinned tool downloads):
#   docker build -f operations/openshell/Dockerfile.controller \
#     -t mac-env-controller:local operations/openshell
# Create:
#   openshell sandbox create --name mac-env-controller \
#     --from mac-env-controller:local \
#     --policy docs/openshell/policy-controller.yaml

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1

ARG OPA_VERSION=1.22.4
ARG OPA_SHA256=ea958fca8a657e4ce04df74c9b1c30220b368ddcf75fb3aa50bf306d55775dbf
ARG RESTIC_VERSION=0.19.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        bzip2 \
        git \
        python3 \
        python3-venv \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -c 'import sys; assert sys.version_info >= (3, 11)' \
    && mkdir -p /opt/mac-env/tools /opt/mac-env/work \
    && chmod 755 /opt/mac-env /opt/mac-env/tools /opt/mac-env/work

# Pinned linux/arm64 tools (checksum-verified).
RUN set -eu \
    && curl -fsSL "https://github.com/open-policy-agent/opa/releases/download/v${OPA_VERSION}/opa_linux_arm64" \
        -o /opt/mac-env/tools/opa \
    && echo "${OPA_SHA256}  /opt/mac-env/tools/opa" | sha256sum -c - \
    && chmod 755 /opt/mac-env/tools/opa \
    && curl -fsSL "https://github.com/restic/restic/releases/download/v${RESTIC_VERSION}/SHA256SUMS" -o /tmp/SHA256SUMS \
    && curl -fsSL "https://github.com/restic/restic/releases/download/v${RESTIC_VERSION}/restic_${RESTIC_VERSION}_linux_arm64.bz2" \
        -o /tmp/restic.bz2 \
    && awk "/restic_${RESTIC_VERSION}_linux_arm64\\.bz2\$/ {print \$1 \"  /tmp/restic.bz2\"; exit}" /tmp/SHA256SUMS | sha256sum -c - \
    && bunzip2 -c /tmp/restic.bz2 > /opt/mac-env/tools/restic \
    && chmod 755 /opt/mac-env/tools/restic \
    && rm -f /tmp/restic.bz2 /tmp/SHA256SUMS \
    && /opt/mac-env/tools/opa version \
    && /opt/mac-env/tools/restic version

ENV PATH="/opt/mac-env/tools:${PATH}"
# OpenShell sandbox identity cannot use a root-owned WORKDIR under /opt.
WORKDIR /tmp
CMD ["bash", "-lc", "python3 --version && opa version | head -1 && restic version"]
