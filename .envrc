# Agent Harness — automatic environment setup
# Requires direnv (https://direnv.net/)
# Activates project git hooks and documents recovery tooling.

# Activate project git hooks
if [ -d .githooks ]; then
  git config core.hooksPath .githooks
fi

# Local nix-built tools (after: nix build .#restic .#mac-env)
PATH_add result/bin

# Controller development defaults (override in .envrc.local; never commit secrets)
# export MAC_ENV_OPA=$PWD/operations/.cache/opa
# export MAC_ENV_RESTIC=$PWD/result/bin/restic
